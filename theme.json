{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1240px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        {
          "name": "Primary",
          "slug": "primary",
          "color": "#38bdf8"
        },
        {
          "name": "Primary Dark",
          "slug": "primary-dark",
          "color": "#0ea5e9"
        },
        {
          "name": "Accent",
          "slug": "accent",
          "color": "#22c55e"
        },
        {
          "name": "Surface",
          "slug": "surface",
          "color": "#0f172a"
        },
        {
          "name": "Surface Alt",
          "slug": "surface-alt",
          "color": "#131d33"
        },
        {
          "name": "Dark",
          "slug": "dark",
          "color": "#020617"
        },
        {
          "name": "Text",
          "slug": "text",
          "color": "#e5eefc"
        },
        {
          "name": "Muted",
          "slug": "muted",
          "color": "#94a3b8"
        }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif",
          "slug": "system",
          "name": "System"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "size": "0.75rem",
          "name": "XS"
        },
        {
          "slug": "sm",
          "size": "0.875rem",
          "name": "SM"
        },
        {
          "slug": "md",
          "size": "1rem",
          "name": "MD"
        },
        {
          "slug": "lg",
          "size": "1.125rem",
          "name": "LG"
        },
        {
          "slug": "xl",
          "size": "1.375rem",
          "name": "XL"
        },
        {
          "slug": "xxl",
          "size": "clamp(2.2rem, 4vw, 3.5rem)",
          "name": "XXL"
        }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "slug": "20",
          "size": "0.5rem",
          "name": "8"
        },
        {
          "slug": "30",
          "size": "0.75rem",
          "name": "12"
        },
        {
          "slug": "40",
          "size": "1rem",
          "name": "16"
        },
        {
          "slug": "50",
          "size": "1.5rem",
          "name": "24"
        },
        {
          "slug": "60",
          "size": "2rem",
          "name": "32"
        },
        {
          "slug": "70",
          "size": "3rem",
          "name": "48"
        },
        {
          "slug": "80",
          "size": "4rem",
          "name": "64"
        }
      ],
      "units": [
        "px",
        "%",
        "em",
        "rem",
        "vw",
        "vh"
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#020617",
      "text": "#e5eefc"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--system)",
      "lineHeight": "1.7"
    },
    "elements": {
      "link": {
        "color": {
          "text": "#38bdf8"
        },
        ":hover": {
          "color": {
            "text": "#7dd3fc"
          }
        }
      },
      "heading": {
        "color": {
          "text": "#f8fafc"
        },
        "typography": {
          "lineHeight": "1.15"
        }
      },
      "button": {
        "border": {
          "radius": "999px"
        },
        "color": {
          "background": "#38bdf8",
          "text": "#04111f"
        },
        "spacing": {
          "padding": {
            "top": "0.875rem",
            "right": "1.35rem",
            "bottom": "0.875rem",
            "left": "1.35rem"
          }
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ]
}